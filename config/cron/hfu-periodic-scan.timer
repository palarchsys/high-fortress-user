[Unit]
Description=Relance l'analyse ClamAV toutes les deux heures

[Timer]
OnBootSec=${HFU_PERIODIC_ON_BOOT_SEC}
OnUnitActiveSec=${HFU_PERIODIC_EVERY}
AccuracySec=${HFU_PERIODIC_ACCURACY}
Persistent=${HFU_TIMER_PERSISTENT}
Unit=hfu-periodic-scan.service

[Install]
WantedBy=timers.target
