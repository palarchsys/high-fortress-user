[Unit]
Description=Avis lorsqu'un redémarrage est utile
After=local-fs.target multi-user.target

[Service]
Type=oneshot
Nice=${G_WATCHDOG_LIMIT_NICE}
IOSchedulingClass=idle
CPUQuota=${cpu_quota}%
ExecStart=${G_CONFIG_BASE_DIRECTORY}/cron/bin/reboot-notice.sh
