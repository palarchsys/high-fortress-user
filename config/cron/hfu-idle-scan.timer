[Unit]
Description=Relance l'analyse différée des bibliothèques

[Timer]
OnUnitActiveSec=${HFU_IDLE_EVERY}
AccuracySec=${HFU_IDLE_ACCURACY}
Persistent=${HFU_TIMER_PERSISTENT}
Unit=hfu-idle-scan.service

[Install]
WantedBy=timers.target
