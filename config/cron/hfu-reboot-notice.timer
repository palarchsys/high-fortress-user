# =============================================================================

[Unit]
Description=Vérifie si un redémarrage est utile

[Timer]
OnUnitActiveSec=${HFU_REBOOT_EVERY}
AccuracySec=${HFU_REBOOT_ACCURACY}
Persistent=${HFU_TIMER_PERSISTENT}
Unit=hfu-reboot-notice.service

[Install]
WantedBy=timers.target
