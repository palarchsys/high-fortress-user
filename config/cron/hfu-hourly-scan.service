[Unit]
Description=Passe AIDE, rkhunter, chkrootkit et debsums toutes les heures
After=local-fs.target multi-user.target

[Service]
Type=oneshot
Nice=${HF_WATCHDOG_LIMIT_NICE}
IOSchedulingClass=idle
CPUQuota=${cpu_quota}%
ExecStart=${HF_CONFIG_BASE_DIRECTORY}/cron/bin/hourly-scan.sh
