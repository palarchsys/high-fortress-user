[Unit]
Description=Relance l'analyse ClamAV toutes les deux heures

[Timer]
OnBootSec=${W_PERIODIC_ON_BOOT_SEC}
OnUnitActiveSec=${W_PERIODIC_EVERY}
AccuracySec=${W_PERIODIC_ACCURACY}
Persistent=${W_TIMER_PERSISTENT}
Unit=w-periodic-scan.service

[Install]
WantedBy=timers.target
