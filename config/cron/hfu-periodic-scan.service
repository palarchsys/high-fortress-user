[Unit]
Description=Analyse ClamAV toutes les deux heures
After=local-fs.target multi-user.target

[Service]
Type=oneshot
Nice=${HF_WATCHDOG_LIMIT_NICE}
IOSchedulingClass=idle
CPUQuota=${cpu_quota}%
Environment=HFU_CLAMAV_DEFER=1
ExecStart=${HF_CONFIG_BASE_DIRECTORY}/cron/bin/clamav.sh
