# =============================================================================

[Unit]
Description=Vérifie si un redémarrage est utile

[Timer]
OnUnitActiveSec=${W_REBOOT_EVERY}
AccuracySec=${W_REBOOT_ACCURACY}
Persistent=${W_TIMER_PERSISTENT}
Unit=w-reboot-notice.service

[Install]
WantedBy=timers.target
