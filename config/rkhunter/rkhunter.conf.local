UPDATE_MIRRORS=1
MIRRORS_MODE=0
WEB_CMD=""
UPDATE_LANG="en"
SCRIPTWHITELIST=/usr/bin/lwp-request
ALLOWDEVFILE=/dev/shm/sem.haveged_sem
ALLOWDEVFILE=/dev/shm/*
ALLOWDEVFILE=/dev/shm/*/*
ALLOWDEVFILE=/dev/shm/*/*/*
ALLOWDEVFILE=/dev/log
ALLOWHIDDENFILE=/etc/.resolv.conf.systemd-resolved.bak
ALLOWHIDDENFILE=/etc/.updated
ALLOWHIDDENDIR=/snap
