^/usr/lib/modules/\S+/vdso/\.build-id(\s|$)
^/usr/lib/python3/dist-packages/fail2ban/tests/
^/usr/lib/ruby/vendor_ruby/rubygems/.*\.document(\s|$)
^/usr/lib/firmware/.*/\.notice\.zst(\s|$)
